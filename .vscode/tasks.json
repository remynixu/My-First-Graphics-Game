{
    "version": "2.0.0",
    "tasks": [
        /* DEBUG */
        {
            "label": "0. Clean Build (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path 'build_debug') { Remove-Item -Recurse -Force 'build_debug'}"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "1. CMake Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}\\.",
                "-B", "${workspaceFolder}\\build_debug",
                "-G", "MinGW Makefiles",
                "-DCMAKE_MAKE_PROGRAM=C:\\raylib\\w64devkit\\bin\\make.exe",
                "-DCMAKE_C_COMPILER=C:\\raylib\\w64devkit\\bin\\gcc.exe",
                "-DCMAKE_BUILD_TYPE=debug"
            ],
            "dependsOn": [
                "0. Clean Build"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "2. CMake Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build_debug"
            ],
            "dependsOn": [
                "1. CMake Configure (Debug)"
            ]
        },
        {
            "label": "2.1 Copy Assets (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Copy-Item -Path 'src\\asset' -Destination 'build_debug' -Recurse -Force"
            ],
            "dependsOn":[
                "2. CMake Build (Debug)"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },

        /* RELEASE */
        {
            "label": "0. Clean Build (Release)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path 'build_release') { Remove-Item -Recurse -Force 'build_release'}; if (Test-Path 'Arundel.zip' -PathType Leaf) { Remove-Item -Force 'Arundel.zip' }"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "1. CMake Configure (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}\\.",
                "-B", "${workspaceFolder}\\build_release",
                "-G", "MinGW Makefiles",
                "-DCMAKE_MAKE_PROGRAM=C:\\raylib\\w64devkit\\bin\\make.exe",
                "-DCMAKE_C_COMPILER=C:\\raylib\\w64devkit\\bin\\gcc.exe",
                "-DCMAKE_BUILD_TYPE=release"
            ],
            "dependsOn": ["0. Clean Build (Release)"]
        },
        {
            "label": "2. CMake Build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build_release"
            ],
            "dependsOn": [
                "1. CMake Configure (Release)"
            ]
        },
        {
            "label": "2.1 Copy Assets (Release)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Copy-Item -Path 'src\\asset' -Destination 'build_release' -Recurse -Force"
            ],
            "dependsOn":[
                "2. CMake Build (Release)"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "3. Package Playable Zip",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Compress-Archive -Path 'build_release/Arundel.exe','build_release/asset' -DestinationPath 'Arundel.zip' -Force"
            ],
            "group": {
                "kind": "build",
                "isDefault": true // Ctrl+Shift+B
            },
            "dependsOn": [
                "2.1 Copy Assets (Release)"
            ]
        }
    ]
}