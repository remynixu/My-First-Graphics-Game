{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "0. Clean Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path 'build') { Remove-Item -Recurse -Force 'build'}"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "1. CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}\\.",
                "-B", "${workspaceFolder}\\build",
                "-G", "MinGW Makefiles",
                "-DCMAKE_MAKE_PROGRAM=C:\\raylib\\w64devkit\\bin\\make.exe",
                "-DCMAKE_C_COMPILER=C:\\raylib\\w64devkit\\bin\\gcc.exe"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\raylib\\w64devkit\\bin;${env:PATH}"
                }
            },
            "dependsOn": [
                "0. Clean Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "2. CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\raylib\\w64devkit\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "1. CMake Configure"
            ],
            "problemMatcher": ["$gcc"]
        }
    ]
}

